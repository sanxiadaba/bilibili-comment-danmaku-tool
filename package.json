{
  "name": "bilibili-comment-danmaku-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "server": "powershell -ExecutionPolicy Bypass -File scripts/start_server.ps1",
    "fetch": "python backend/app_cli.py fetch-video",
    "test": "pnpm test:encoding && pnpm test:backend && pnpm test:frontend",
    "test:encoding": "python scripts/check_encoding.py",
    "test:backend": "python -B -m unittest discover -s tests/backend -p \"test_*.py\"",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "build": "pnpm test && tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/build_nuitka_windows.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.555.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
